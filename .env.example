# Base de données Neon (créée depuis Vercel > Storage > Neon : remplie automatiquement)
DATABASE_URL=postgres://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# Une longue phrase secrète à toi (sert à signer les connexions)
JWT_SECRET=change-moi-par-une-longue-phrase-secrete

# Clé Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle Gemini (change-le si Google en renomme un)
GEMINI_MODEL=gemini-3.5-flash

# Optionnel : clé Google Cloud Translation (demande un compte de facturation)
# Si vide, c'est Gemini qui traduit.
GOOGLE_TRANSLATE_API_KEY=
